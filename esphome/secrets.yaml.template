# Copy to secrets.yaml (gitignored) and fill in:  cp secrets.yaml.template secrets.yaml
#
# Wi-Fi must be 2.4 GHz (the ESP32-S3 has no 5 GHz radio).
wifi_ssid: "YOUR_2_4GHZ_WIFI_NAME"
wifi_password: "YOUR_WIFI_PASSWORD"

# Home Assistant API encryption key, 32 random bytes in base64:  openssl rand -base64 32
api_key: "REPLACE_WITH_OUTPUT_OF_openssl_rand_-base64_32"

# Password for over-the-air updates:  openssl rand -hex 16
ota_password: "REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_16"
